# =========================================================================
# Plantilla de variables del notification-service.
# Copia este archivo a notification-1.env (gitignored) y rellena los valores.
# Las variables globales (SPRING_PROFILES_ACTIVE, EUREKA_..., TZ) viven en global.env.
# =========================================================================

# Puerto del microservicio
SERVER_PORT=9002

# Hostname con el que se registra en Eureka.
# Convencion del proyecto: <alias-corto>-<N>. Ver CLAUDE.md > Naming convention.
INSTANCE_HOSTNAME=notification-1

# Canal de notificacion activo (email | sms | push). Por defecto: email.
NOTIFICATION_CHANNEL=email

# =========================================================================
# KAFKA
# =========================================================================
# Broker local con Docker: localhost:9092
# Broker managed (dev/qa/prod): kafka.tu-dominio.com:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Consumer group; debe ser unico por servicio para recibir todos los mensajes del topic
KAFKA_CONSUMER_GROUP_ID=notification-service

# --- Seguridad del broker -------------------------------------------------
# dev (local / broker propio sin auth): PLAINTEXT  -> deja estas 3 sin definir.
# qa / prod (broker remoto): SASL_SSL (TLS + autenticacion).
#KAFKA_SECURITY_PROTOCOL=SASL_SSL
#KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# JAAS completo en UNA linea. Elige el modulo segun tu broker:
#   Cluster auto-gestionado / AWS MSK (SCRAM):
#     KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="USUARIO" password="CLAVE";
#   Confluent Cloud / SASL-PLAIN (API key + secret):
#     KAFKA_SASL_MECHANISM=PLAIN
#     KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="API_KEY" password="API_SECRET";

# =========================================================================
# MAIL (SMTP)
# =========================================================================
# Local con Mailpit/MailHog:
#   MAIL_HOST=localhost  MAIL_PORT=1025  MAIL_SMTP_AUTH=false  MAIL_SMTP_STARTTLS=false
# Produccion con SES / SendGrid / SMTP real:
#   MAIL_HOST=email-smtp.us-east-1.amazonaws.com  MAIL_PORT=587  MAIL_SMTP_AUTH=true  MAIL_SMTP_STARTTLS=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@pharmaflow.com
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# Nombre comercial mostrado en los correos y como display-name del remitente
MAIL_APP_NAME=PharmaFlow

# Base del frontend para construir los enlaces (set-password, reset-password...)
FRONTEND_BASE_URL=http://localhost:4200
