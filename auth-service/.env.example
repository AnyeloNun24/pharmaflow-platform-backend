# Puerto del microservicio
SERVER_PORT=9001

# Hostname con el que se registra en Eureka.
# Convencion del proyecto: <alias-corto>-<N>. Ver CLAUDE.md > Naming convention.
INSTANCE_HOSTNAME=auth-1

# =========================================================================
# DATASOURCE
# =========================================================================
# Postgres en otra PC de la LAN o local     -> jdbc:postgresql://192.168.X.X:5432/pharmaflow_dev
# Postgres managed (dev/qa/prod)            -> jdbc:postgresql://db.tu-dominio.com:5432/<db>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://XXX.XXX.XXX.XXX:5432/XXXX
SPRING_DATASOURCE_USERNAME=XXXX
SPRING_DATASOURCE_PASSWORD=XXXX

# Tuning del pool Hikari.
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_MAX_LIFETIME=1800000
DB_POOL_CONNECTION_TIMEOUT=30000

# SEGURIDAD - JWT
JWT_ISSUER=pharmaflow-auth
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# Generar con: openssl rand -hex 32
# Rotar antes de prod y manejar via secret manager (Vault, AWS SM, Doppler).
JWT_HMAC_SECRET=XXXX

# SEGURIDAD - Password tokens
PASSWORD_SET_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# POLITICAS DE SEGURIDAD
SECURITY_MAX_FAILED_ATTEMPTS=5
